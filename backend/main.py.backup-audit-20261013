                "INSERT INTO customers(customer_key,customer_name,operator) VALUES(%s,%s,%s) "
                "ON DUPLICATE KEY UPDATE customer_name=VALUES(customer_name),operator=VALUES(operator)",
                (customer_key, customer, operator),
