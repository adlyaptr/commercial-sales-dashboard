@app.get("/api/monthly")
def monthly_summary(request: Request, year: int):
    require_login(request)

    if year < 2000 or year > 2100:
        raise HTTPException(
            status_code=400,
            detail="Tahun harus berada di antara 2000 dan 2100."
        )

    with db() as con:
        rows = con.execute("""
            SELECT
                c.customer_key,
                c.customer_name,
                c.operator,
                MONTH(s.report_date) AS month_number,
                SUM(s.so) AS total_so,
                SUM(s.actual) AS total_actual
            FROM sales s
            JOIN customers c
                ON c.customer_key = s.customer_key
            WHERE YEAR(s.report_date) = %s
            GROUP BY
                c.customer_key,
                c.customer_name,
                c.operator,
                MONTH(s.report_date)
            ORDER BY
                c.operator,
                c.customer_name,
                month_number
        """, (year,)).fetchall()

    items = [
        {
            "customer_key": row["customer_key"],
            "customer": row["customer_name"],
            "operator": row["operator"],
            "month": int(row["month_number"]),
            "so": float(row["total_so"] or 0),
            "actual": float(row["total_actual"] or 0),
        }
        for row in rows
    ]

    return {
        "year": year,
        "items": items,
    }


@app.get("/api/dashboard")
def dashboard(request: Request, report_date: Optional[str] = None):
    require_login(request)
    with db() as con:
        if not report_date:
            row = con.execute("SELECT MAX(report_date) AS d FROM sales").fetchone()
            report_date = row["d"]
        if not report_date:
            return {"report_date": None, "total_actual": 0, "customer_active": 0, "operators": {}, "trend": [], "latest_import": None}
        if isinstance(report_date, date):
            report_date = report_date.isoformat()
        try:
            datetime.strptime(report_date, "%Y-%m-%d")
        except ValueError:
            raise HTTPException(status_code=400, detail="Format tanggal tidak valid.")
        rows = con.execute("""
            SELECT c.customer_name, c.operator, s.so, s.actual
            FROM sales s JOIN customers c ON c.customer_key=s.customer_key
            WHERE s.report_date=%s ORDER BY c.operator, c.customer_name
        """, (report_date,)).fetchall()
        operator_data = {op: [] for op in OPERATORS}
        for r in rows:
            operator_data[r["operator"]].append({
                "customer": r["customer_name"], "so": r["so"], "actual": r["actual"],
                "diff": r["actual"] - r["so"]
            })
        trend_rows = con.execute("""
            SELECT s.report_date, c.operator, SUM(s.actual) AS actual
            FROM sales s JOIN customers c ON c.customer_key=s.customer_key
            WHERE s.report_date BETWEEN DATE_SUB(%s, INTERVAL 30 DAY) AND %s
            GROUP BY s.report_date,c.operator ORDER BY s.report_date
        """, (report_date, report_date)).fetchall()
        trend_map = {}
        for r in trend_rows:
            trend_date = r["report_date"].isoformat()
            trend_map.setdefault(trend_date, {op: 0 for op in OPERATORS})
            trend_map[trend_date][r["operator"]] = r["actual"] or 0
        latest = con.execute("SELECT filename, imported_at FROM import_history WHERE status='BERHASIL' ORDER BY id DESC LIMIT 1").fetchone()
        total_actual = sum(r["actual"] for r in rows)
        return {
            "report_date": report_date,
            "total_actual": total_actual,
            "customer_active": len(rows),
            "operators": operator_data,
