# Salin menjadi .env lalu isi. File .env tidak ikut di-commit.
# Hindari karakter $, spasi, dan tanda kutip pada nilai.

# Domain untuk HTTPS. Di VM: <ip-dengan-strip>.sslip.io, di laptop: localhost
DOMAIN=localhost

# production mewajibkan APP_PASSWORD >= 12 karakter dan SESSION_SECRET >= 32 karakter
APP_ENV=production
APP_USERNAME=admin
APP_PASSWORD=ganti-dengan-password-panjang
SESSION_SECRET=ganti-dengan-string-acak-minimal-32-karakter

MYSQL_DATABASE=commercial_sales_dashboard
MYSQL_USER=commercial
MYSQL_PASSWORD=ganti-password-database
MYSQL_ROOT_PASSWORD=ganti-password-root-database

# Sinkronisasi Daily Sales dari lampiran email Planner melalui Yahoo-compatible IMAP.
# Aktifkan hanya setelah workbook Planner tervalidasi. Jangan commit App Password.
YAHOO_SYNC_ENABLED=false
YAHOO_IMAP_HOST=imap.mail.yahoo.com
YAHOO_IMAP_PORT=993
YAHOO_EMAIL=
YAHOO_APP_PASSWORD=
YAHOO_ALLOWED_SENDER=reethauplanner@gmail.com
YAHOO_IMAP_FOLDER=INBOX
